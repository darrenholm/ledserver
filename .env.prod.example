# =============================================================================
# PRODUCTION TEMPLATE — copy to .env on the host running docker compose.
# Every value marked GENERATE / REPLACE must be filled in before bringing the
# stack up; the API refuses to start in production with default values.
# =============================================================================

NODE_ENV=production
API_PORT=4000

# Generate with:  openssl rand -base64 48
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=12h

# Public-facing app: empty whitelist (Caddy + rate-limit + auth handle access).
# To restrict further, list CIDRs of trusted offices/VPNs here.
IP_WHITELIST=

# Bootstrap admin user. Pick a strong unique password; the app refuses to
# start in production with values like "admin"/"changeme"/"password".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- COEX ---
COEX_DEFAULT_PORT=5000
COEX_TIMEOUT_MS=5000
COEX_RETRIES=2

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=novastar
POSTGRES_USER=novastar
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Media server ---
# Public URL Taurus controllers will pull media from.
MEDIA_PUBLIC_BASE_URL=https://led.holmgraphics.ca/media

# --- Frontend ---
VITE_API_BASE_URL=/api

# --- Caddy (TLS) ---
LED_DOMAIN=led.holmgraphics.ca
ACME_EMAIL=darren@holmgraphics.ca
